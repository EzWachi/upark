# Postgres. En local, una base propia; en producción, el pooler de Neon o Supabase.
DATABASE_URL="postgresql://usuario:password@localhost:5432/upark?schema=public"

# Auth.js. Generar con: npx auth secret
AUTH_SECRET=""

# Primer super admin, lo crea prisma/seed.ts (npx prisma db seed).
SUPERADMIN_CORREO="superadmin@upark.local"
SUPERADMIN_PASSWORD=""

# URL pública de la app, para los enlaces de los correos.
APP_URL="http://localhost:3000"

# RN-11. Dominios de correo aceptados para miembros, separados por coma.
DOMINIOS_INSTITUCIONALES="ulacit.ed.cr,ulacit.ac.cr"
